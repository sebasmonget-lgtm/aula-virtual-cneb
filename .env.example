# Crear estas variables únicamente con las cuentas nuevas del proyecto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Base PostgreSQL embebida para desarrollo local (sin Docker ni cuenta externa).
NEXT_PUBLIC_LOCAL_DATABASE_URL=http://127.0.0.1:8788
# Identidad de simulación local; nunca reemplaza Auth del staging.
AYNI_LOCAL_TEACHER_ID=
# Habilita manualmente db:export solo mientras se prepara un respaldo local.
AYNI_ALLOW_LOCAL_EXPORT=0
