# LOCAL: PGlite embebido e identidad ficticia, solo loopback.
AYNI_DB_MODE=local
AYNI_AUTH_MODE=local
# Base PostgreSQL embebida para desarrollo local.
AYNI_LOCAL_TEACHER_ID=
NEXT_PUBLIC_LOCAL_DATABASE_URL=http://127.0.0.1:8788
# Exportación local temporal y deliberada; deshabilitada por defecto.
AYNI_ALLOW_LOCAL_EXPORT=0

# STAGING: PostgreSQL Supabase y Auth real, con datos ficticios únicamente.
# Cambiar conjuntamente AYNI_DB_MODE=postgres y AYNI_AUTH_MODE=supabase.
# Aplicar supabase/migrations en orden antes de iniciar el servidor.
# SUPABASE_DB_URL: conexión directa o session pooler; TLS obligatorio.
SUPABASE_DB_URL=
AYNI_SUPABASE_URL=
AYNI_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: clave aleatoria estable de 32+ caracteres y dominio técnico para alias de DNI.
# No registrar DNI ni este valor en el repositorio. Cambiar la clave exige migrar los alias de acceso.
AYNI_DNI_LOGIN_PEPPER=
AYNI_DNI_ALIAS_DOMAIN=
# Clave aleatoria estable (32+ caracteres) para firmar la sesión de 30 días.
AYNI_SESSION_SIGNING_KEY=
# Secreto independiente de 32+ caracteres para crear el primer administrador.
# Retirar de Vercel después del alta; no guardarlo en el repositorio.
AYNI_ADMIN_SETUP_KEY=
AYNI_AUTH_COOKIE_SECURE=1
# Origen exacto de la interfaz en staging (HTTPS, mismo sitio que la API).
AYNI_ALLOWED_ORIGIN=
AYNI_API_HOST=127.0.0.1

# PUBLIC: solo URL de la API, nunca credenciales.
# En Vercel dejarla vacía: la API Next usa el mismo origen HTTPS.
NEXT_PUBLIC_AYNI_API_URL=

# SERVER ONLY: jamás usar NEXT_PUBLIC_ para estos valores.
OPENAI_API_KEY=
# Decisiones Jev mediante OpenRouter. Solo backend; apagado para docentes por defecto.
OPENROUTER_API_KEY=
AYNI_JEV_ENABLED=0
AYNI_JEV_COMPETENCIES=0
AYNI_JEV_PROJECT_IMAGE=0
AYNI_JEV_WORKSHOP_SHEET=0
# Usar una versión fijada, nunca jev-latest ni jev-router.
AYNI_JEV_MODEL=typesafe/jev-1.13
# Solo terminal administrativa para alta/reinicio de cuentas; también servidor de Storage privado si se habilita.
AYNI_SUPABASE_SERVICE_ROLE_KEY=
