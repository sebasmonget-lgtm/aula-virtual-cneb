# Crear estas variables únicamente con las cuentas nuevas del proyecto.
# local mantiene PGlite; supabase verifica cada petición con Supabase Auth.
AYNI_AUTH_MODE=local
AYNI_SUPABASE_URL=
AYNI_SUPABASE_PUBLISHABLE_KEY=
AYNI_AUTH_COOKIE_SECURE=1
# Origen exacto de la interfaz en staging (HTTPS, mismo sitio que la API).
AYNI_ALLOWED_ORIGIN=
AYNI_API_HOST=127.0.0.1
# URL pública de la API; solo URL, nunca una clave.
NEXT_PUBLIC_AYNI_API_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Base PostgreSQL embebida para desarrollo local (sin Docker ni cuenta externa).
NEXT_PUBLIC_LOCAL_DATABASE_URL=http://127.0.0.1:8788
# Identidad de simulación local; nunca reemplaza Auth del staging.
AYNI_LOCAL_TEACHER_ID=
# Habilita manualmente db:export solo mientras se prepara un respaldo local.
AYNI_ALLOW_LOCAL_EXPORT=0
